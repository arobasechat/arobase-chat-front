{
  "name": "arobase-chat-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ipfs": "tsc -b && VITE_HASH_ROUTER=true vite build --base=./",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:prod": "tsc -b && vite build --mode production",
    "deploy:cf:dry": "pnpm build:prod && wrangler deploy --dry-run",
    "deploy:cf": "pnpm build:prod && wrangler deploy",
    "test": "node --test --test-reporter=spec test/*.test.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2",
    "@noble/curves": "2",
    "@noble/hashes": "2",
    "@tanstack/query-async-storage-persister": "5",
    "@tanstack/react-query": "5",
    "@tanstack/react-query-persist-client": "5",
    "@tanstack/react-virtual": "3",
    "clsx": "^2.1.1",
    "dexie": "4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "19",
    "react-dom": "19",
    "react-router-dom": "7",
    "uqr": "^0.1.3",
    "viem": "2",
    "zustand": "5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "4",
    "typescript": "^7.0.2",
    "vite": "8",
    "vite-plugin-pwa": "2",
    "workbox-window": "^7.4.1",
    "wrangler": "4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/arobasechat/arobase-chat-front.git"
  }
}
