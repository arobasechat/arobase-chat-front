{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arobase",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "arobase.chat", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
